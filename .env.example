# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (perfil.mercadopago.com.br/developer/panel/app > Credenciais)
# Use as credenciais de TESTE primeiro, troque para produção só quando validar o fluxo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site (usada nos back_urls do checkout e no webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preço da oferta em reais (ex: 47.00)
NEXT_PUBLIC_OFERTA_PRECO=47.00

# --- Próxima etapa (bot de WhatsApp) — não usados ainda pelo funil ---
# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Provedor de IA plugável: "anthropic" ou "openai"
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
