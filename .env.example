# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (perfil.mercadopago.com.br/developer/panel/app > Credenciais)
# Use as credenciais de TESTE primeiro, troque para produção só quando validar o fluxo.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site (usada nos back_urls do checkout e no webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preço da oferta em reais (ex: 47.00)
NEXT_PUBLIC_OFERTA_PRECO=47.00

# --- Chatbot do WhatsApp ---
# Webhook da Meta (developers.facebook.com > seu App > WhatsApp > Configuration).
# Globais: um único Meta App atende todos os clientes (identificados por
# phone_number_id, que fica salvo por cliente na tabela `clientes`, não aqui).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Provedor de IA plugável: "gemini" (implementado), "anthropic" ou "openai" (ainda não implementados)
AI_PROVIDER=gemini

# Gemini (grátis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
